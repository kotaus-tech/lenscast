<ui:FluentWindow x:Class="Lenscast.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Lenscast" Width="1120" Height="800" MinWidth="760" MinHeight="580" Background="#0E0E11" Foreground="#ECECF1" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <ui:TitleBar Title="Lenscast" Grid.Row="0" Height="40"/>
 <Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,20"><TextBlock Text="Lenscast" FontSize="30"/><TextBlock Text="Телефон рядом. Картинка — перед вами." Foreground="#9A9AA8" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
 <TabControl Grid.Row="1" Background="Transparent">
  <TabItem Header="Подключение"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,8,0">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ваш телефон" FontSize="24"/><TextBlock Text="Нажмите «Старт» в Lenscast на телефоне. Для Wi-Fi подключите телефон к тому же роутеру, что и ПК." Foreground="#9A9AA8"/>
   <WrapPanel><Button x:Name="FindWifi" Content="Найти телефоны" Click="Discover_Click"/><Button x:Name="FindUsb" Content="Проверить USB" Click="Usb_Click"/></WrapPanel>
   <TextBlock x:Name="WifiHint" Text="Wi-Fi: нажмите «Старт» на телефоне" Foreground="#9A9AA8"/>
   <TextBlock x:Name="UsbHint" Text="USB: подключите телефон и подтвердите доверие" Foreground="#9A9AA8"/>
   <ListBox x:Name="Devices" MinHeight="90" DisplayMemberPath="Label" SelectionChanged="Devices_SelectionChanged"/>
   <TextBlock Text="Если телефон не найден, введите его адрес вручную" Margin="0,16,0,0"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Address" ToolTip="IP-адрес телефона"/><TextBox x:Name="Code" Grid.Column="1" MaxLength="6" ToolTip="Код с телефона"/><Button x:Name="ConnectButton" Grid.Column="2" Background="#8F7CF0" Foreground="#0E0E11" Content="Подключиться" Click="Connect_Click"/></Grid>
   <TextBlock Text="Адрес телефона · код первого подключения" Foreground="#9A9AA8"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Защищённое подключение" FontSize="20"/><TextBlock Text="По Wi-Fi код нужен только один раз. По USB подтвердите отладку на телефоне. Одновременно подключается один телефон."/><Button Content="Отключиться" Click="Disconnect_Click" HorizontalAlignment="Left"/></StackPanel></Border>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Экран"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#17171C" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid><Image x:Name="Preview" Stretch="Uniform" MouseLeftButtonDown="Preview_Down" MouseMove="Preview_Move" MouseLeftButtonUp="Preview_Up" LostMouseCapture="Preview_Lost" MouseWheel="Preview_Wheel"/>
    <TextBlock x:Name="VideoHint" Text="Подключите телефон и разрешите показ экрана" Foreground="#9A9AA8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
   </Border>
   <WrapPanel Grid.Row="1" Margin="0,8,0,0"><Button Content="Назад" Tag="back" Click="Navigation_Click"/><Button Content="Домой" Tag="home" Click="Navigation_Click"/><Button Content="Недавние" Tag="recents" Click="Navigation_Click"/><Button Content="Полный экран" Click="Fullscreen_Click"/><CheckBox Content="Поверх окон" Checked="Topmost_Changed" Unchecked="Topmost_Changed" VerticalAlignment="Center"/></WrapPanel>
   <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="ScreenTelemetry" Text="Подключите телефон"/><TextBlock x:Name="VideoStats" Foreground="#9A9AA8"/><Button Content="Остановить на телефоне" Click="Stop_Click" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid></TabItem>
  <TabItem Header="Веб-камера"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,8,0">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Состояние телефона" FontSize="20"/><TextBlock x:Name="CameraTelemetry" Text="Подключите телефон"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Камера телефона" FontSize="28"/><TextBlock x:Name="CameraStatus" Text="На телефоне выберите «Веб-камера» и нажмите «Запустить камеру»."/>
    <Border Background="#0E0E11" CornerRadius="12" Height="320" ClipToBounds="True" Margin="0,8"><Image x:Name="CameraPreview" Stretch="Uniform"/></Border>
    <TextBlock x:Name="CameraStats" Foreground="#9A9AA8"/>
    <TextBlock Text="Это предпросмотр Lenscast. Системная виртуальная камера для других приложений — блок D." Foreground="#F0B866"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel x:Name="CameraSelectors" IsEnabled="False">
    <TextBlock Text="Изображение и качество" FontSize="20"/>
    <TextBlock Text="Модуль камеры"/><ComboBox x:Name="CameraDevices" DisplayMemberPath="Label" SelectionChanged="CameraDevice_Changed"/>
    <TextBlock Text="Разрешение и частота кадров"/><ComboBox x:Name="CameraModes" DisplayMemberPath="Label" SelectionChanged="CameraMode_Changed"/>
    <TextBlock Text="Список получен от камеры и кодировщика. Выбранное сочетание подтверждается только после появления кадров; фактическая частота показана отдельно." Foreground="#9A9AA8"/>
    <TextBlock Text="Поворот изображения"/><ComboBox x:Name="CameraRotation" SelectionChanged="CameraRotation_Changed"><ComboBoxItem Content="0°" Tag="0"/><ComboBoxItem Content="90°" Tag="90"/><ComboBoxItem Content="180°" Tag="180"/><ComboBoxItem Content="270°" Tag="270"/></ComboBox>
    <CheckBox x:Name="CameraMirror" Content="Отразить изображение" Click="CameraMirror_Click"/>
    <Expander Header="Фокус, экспозиция и баланс белого"><StackPanel x:Name="CameraControls" Margin="8,16"/></Expander>
    <Expander Header="Профи"><StackPanel x:Name="CameraProControls" Margin="8,16"/></Expander>
    <Button Content="Сбросить настройки этой камеры" Click="CameraReset_Click" HorizontalAlignment="Left"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,8,0">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Доверие и конфиденциальность" FontSize="22"/><TextBlock Text="Забыть телефон: удаляет сохранённые токен и отпечаток. При следующем подключении понадобится код."/><Button Content="Забыть телефон" Click="Forget_Click" HorizontalAlignment="Left"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Если что-то пошло не так" FontSize="22"/><TextBlock Text="Сохраните журнал и пришлите его вместе с описанием последнего действия. Коды и токены в журнал не записываются."/><Button Content="Сохранить журнал" Click="Log_Click" HorizontalAlignment="Left"/></StackPanel></Border>
   <TextBlock x:Name="VersionText" Foreground="#9A9AA8"/>
   <TextBlock Text="Трей и автозапуск пока недоступны в этой сборке." Foreground="#9A9AA8"/>
  </StackPanel></ScrollViewer></TabItem>
 </TabControl>
 <Border Grid.Row="2" Padding="16" Background="#1F1F26" CornerRadius="12" Margin="0,16,0,0"><TextBlock x:Name="Status" Text="Готов к подключению" Margin="0"/></Border>
 </Grid>
 </Grid>
</ui:FluentWindow>
