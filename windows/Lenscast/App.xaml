<Application x:Class="Lenscast.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ui:ThemesDictionary Theme="Dark"/><ui:ControlsDictionary/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECECF1"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="42"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Padding" Value="16,8"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="42"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#17171C"/><Setter Property="BorderBrush" Value="#2A2A33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
